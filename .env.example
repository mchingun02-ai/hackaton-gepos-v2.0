# Facebook Messenger чат (Merchant portal → Facebook чат). Дэлгэрэнгүй: docs/FACEBOOK_CHAT.md
# Эдгээрийг бөглөөгүй бол чат ТУРШИЛТЫН горимоор (жишээ Page, жишээ чат) ажиллана.
# Gerege-ийн ӨӨРИЙН Meta App-ын утга — өөр төслийн (жишээ нь Yuno) түлхүүр ашиглахгүй.
FB_APP_ID=
FB_APP_SECRET=
# Webhook бүртгэхэд Meta-д оруулах дурын урт нууц үг
FB_VERIFY_TOKEN=
# Page токеныг шифрлэх түлхүүр (урт санамсаргүй мөр). Хоосон бол FB_APP_SECRET-ээс гаргана.
FB_TOKEN_KEY=
# Facebook Login for Business-ийн Configuration ID (сонголттой; байхгүй бол scope-оор хүснэ)
FB_LOGIN_CONFIG_ID=
# Нийтэд харагдах хаяг (OAuth буцах хаяг: <SP_PUBLIC_URL>/api/fb/callback)
SP_PUBLIC_URL=https://portal.gerege.mn
# FB_GRAPH_VERSION=v23.0
# SP_DATA_DIR=./data

# AI туслах (Gemini) — мерчант Gmail-ээрээ нэвтэрнэ. Дэлгэрэнгүй: docs/AI_ASSISTANT.md
# Gerege-ийн Google Cloud → OAuth client (Web application). Хоосон бол ТУРШИЛТЫН горим.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GEMINI_MODEL=gemini-3.5-flash
# Ачаалал ихтэй үед шилжих загварууд
# GEMINI_FALLBACKS=gemini-3.5-flash-lite,gemini-3-flash-preview

# AI туслах — Qwen (Gerege-ийн AI gateway, OpenAI-тэй ижил API). Түлхүүрийг зөвхөн серверт.
QWEN_API_URL=https://ali.gerege.mn/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3-vl-plus

# ── AI ажилтан (/ai) — Alibaba Cloud Model Studio (хакатон: бүх inference зөвхөн Qwen) ──
# https://modelstudio.console.alibabacloud.com → API Key. Region: intl (Сингапур) | cn | us
DASHSCOPE_API_KEY=
DASHSCOPE_REGION=intl
AI_MODEL=qwen-plus
AI_FAST_MODEL=qwen-flash
AI_EMBED_MODEL=text-embedding-v4
AI_OMNI_MODEL=qwen3-omni-flash
AI_TTS_MODEL=qwen3-tts-flash
AI_TTS_VOICE=Cherry

# ── QPay (урьдчилсан төлбөр). Хоосон бол QPay-ийн нийтийн sandbox (TEST_MERCHANT) ──
QPAY_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=TEST_MERCHANT
QPAY_PASSWORD=123456
QPAY_INVOICE_CODE=TEST_INVOICE

# ── Нэвтрэлт, токен (docs/ARCHITECTURE.md §3.2) ──
# Widget/зочны токены HMAC түлхүүр — 32+ тэмдэгт санамсаргүй (openssl rand -base64 48). Заавал.
AUTH_SECRET=
# yes бол серверт бүртгэлгүй дэлгүүрийг хөтчийн төлвөөр анх удаа бүртгэнэ (TOFU) — зөвхөн демо/хакатонд
AUTH_ALLOW_BOOTSTRAP=
